{
  "name": "@ast-ai-model-router/cli",
  "version": "0.1.1",
  "description": "AST-based Claude Code and Codex model router with token-cost estimates, CI policy checks, and explainable AI coding-agent model selection.",
  "type": "module",
  "bin": {
    "ast-ai-model-router": "bin/ast-ai-model-router.js",
    "model-router": "bin/ast-ai-model-router.js"
  },
  "files": [
    "bin/",
    "lib/",
    "scripts/",
    "skills/",
    ".claude-plugin/",
    ".codex-plugin/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "lint": "node --check bin/ast-ai-model-router.js && node --check lib/*.js && node --check lib/parsers/*.js",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "pack:dry-run": "npm publish --dry-run --registry=https://registry.npmjs.org --cache=.npm-cache",
    "publish:local": "npm publish --registry=https://registry.npmjs.org --cache=.npm-cache --provenance --access public"
  },
  "keywords": [
    "llm",
    "ai-coding-agent",
    "token-economics",
    "llm-cost-optimization",
    "model-router",
    "model-selection",
    "claude-code",
    "claude-code-model-router",
    "codex",
    "codex-cli",
    "codex-model-router",
    "ast",
    "prompt-cost",
    "developer-tools",
    "ci"
  ],
  "author": {
    "name": "Faraazuddin Mohammed",
    "url": "https://github.com/faraa2m"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faraa2m/ast-ai-model-router.git"
  },
  "homepage": "https://github.com/faraa2m/ast-ai-model-router#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@babel/parser": "^7.28.5",
    "@tokenometer/core": "^1.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0"
  },
  "engines": {
    "node": ">=20"
  }
}
